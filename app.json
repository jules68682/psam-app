{
  "expo": {
    "name": "PSAM",
    "slug": "psam-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "psamapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F4ED"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.preventionsantearthrosemain.app",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#F7F4ED",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "fr.preventionsantearthrosemain.app",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#F7F4ED",
          "dark": {
            "backgroundColor": "#F7F4ED"
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "privacyPolicyUrl": "https://prevention-sante-arthrose-main.fr/politique-de-confidentialite"
    }
  }
}
